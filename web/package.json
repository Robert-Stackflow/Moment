{
  "name": "moment-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx src",
    "lint:fix": "eslint --fix --ext .js,.jsx src",
    "lint:staged": "lint-staged",
    "prettier": "npx prettier --write .",
    "test:ui": "node --test tests/coordinates.test.mjs && node tests/gallery.browser.mjs"
  },
  "dependencies": {
    "@iconify/react": "6.0.3",
    "@robert-stackflow/oneui": "0.5.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.9",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.101",
    "@vitejs/plugin-react": "4.7.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.46.0",
    "playwright": "1.64.1",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.65.1",
    "typescript": "^5.1.6",
    "unocss": "^66.5.4",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "varsIgnorePattern": "^[A-Z]",
          "argsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "^9.0.9"
  }
}
